<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EdenGameLibraryManager.App.ViewModels"
        x:Class="EdenGameLibraryManager.App.Views.CleanupDialog"
        x:DataType="vm:CleanupDialogViewModel"
        Title="Free up cache space"
        Width="620" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,16" />

    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,16,0,0">
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
          <Button Classes="danger" Content="{Binding DeleteButtonText}" Command="{Binding DeleteCommand}" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Border Classes="card">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Candidates}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CleanupCandidateViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="8,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Classes="badge" Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsPinned}">
                      <TextBlock Text="Pinned" FontSize="11" Foreground="White" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding LastUsedText}" Classes="muted small" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
