<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EdenGameLibraryManager.App.ViewModels"
             x:Class="EdenGameLibraryManager.App.Views.ConnectionFormView"
             x:DataType="vm:ConnectionFormViewModel">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,12,*">
      <StackPanel>
        <TextBlock Text="Source" Classes="label" />
        <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Profile name (optional)" Classes="label" />
        <TextBox Text="{Binding ProfileName}" Watermark="e.g. Home server" />
      </StackPanel>
    </Grid>

    <StackPanel Spacing="12" IsVisible="{Binding IsAeroFoil}">
      <StackPanel>
        <TextBlock Text="AeroFoil server URL" Classes="label" />
        <TextBox Text="{Binding ServerUrl}" Watermark="https://aerofoil.example.com" />
      </StackPanel>
      <Grid ColumnDefinitions="*,12,*">
        <StackPanel>
          <TextBlock Text="Username" Classes="label" />
          <TextBox Text="{Binding Username}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Password" Classes="label" />
          <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="False" Classes="revealPasswordButton" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <StackPanel Spacing="8" IsVisible="{Binding IsTorBox}">
      <TextBlock Text="TorBox API key" Classes="label" />
      <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="False" Classes="revealPasswordButton" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="Find it at torbox.app → Settings. The app lists the .nsp, .nsz, .xci and .xcz files in your finished TorBox torrents, Usenet and web downloads, and downloads them straight from TorBox. File names need a [TitleID] tag (for example [0100ABCD12340000]) for names, artwork and update/DLC grouping." />
    </StackPanel>

    <CheckBox IsChecked="{Binding RememberPassword}" IsEnabled="{Binding SupportsPasswordPersistence}" Content="{Binding RememberLabel}" />
    <TextBlock Text="{Binding PersistenceNote}" Classes="muted small" TextWrapping="Wrap" />
    <StackPanel Spacing="12" IsVisible="{Binding IsAeroFoil}">
      <CheckBox IsChecked="{Binding AllowInsecureHttp}" Content="Allow insecure HTTP (trusted LAN or VPN servers only)" />
      <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsHttpUrl}"
                 Text="Plain HTTP sends your password and files unencrypted. Only use it on a private network you trust; use HTTPS over the internet." />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Test Connection" Command="{Binding TestCommand}" IsEnabled="{Binding !IsTesting}" />
      <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsTesting}" VerticalAlignment="Center" />
    </StackPanel>
    <Border Padding="12,8" CornerRadius="8" Background="#332EC27E" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
            IsVisible="{Binding TestPassed}">
      <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" />
    </Border>
    <Border Padding="12,8" CornerRadius="8" Background="#33E5484D" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
            IsVisible="{Binding TestFailed}">
      <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
