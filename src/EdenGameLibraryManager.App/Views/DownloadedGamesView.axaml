<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EdenGameLibraryManager.App.ViewModels"
             x:Class="EdenGameLibraryManager.App.Views.DownloadedGamesView"
             x:DataType="vm:DownloadedGamesViewModel">

  <UserControl.Styles>
    <!-- Updates and DLC are indented under their base game (margins live in styles so .child can override). -->
    <Style Selector="Border.row">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.row.child">
      <Setter Property="Margin" Value="40,0,0,8" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="24,20,24,0">
    <StackPanel DockPanel.Dock="Top" Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Downloaded Games" Classes="h1" />
          <TextBlock Text="Game files in your local games directory" Classes="muted" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding RefreshCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
            <TextBlock Text="Rescan folder" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Storage summary -->
      <Border Classes="section" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*,*,*,*">
            <StackPanel Grid.Column="0">
              <TextBlock Text="Cache limit" Classes="label" />
              <TextBlock Text="{Binding LimitText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Used by managed games" Classes="label" />
              <TextBlock Text="{Binding UsedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Free under limit" Classes="label" />
              <TextBlock Text="{Binding FreeUnderLimitText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="Free disk space" Classes="label" />
              <TextBlock Text="{Binding DiskFreeText}" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Library" Classes="label" />
              <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
          <ProgressBar Value="{Binding UsagePercent}" Maximum="100" IsVisible="{Binding HasLimit}" Height="6" MinHeight="6" />
          <TextBlock Classes="muted small" TextWrapping="Wrap">
            <Run Text="Manually added files (" /><Run Text="{Binding ManualText}" /><Run Text=") don't count toward the limit and are never removed automatically." />
          </TextBlock>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding SearchText}" Watermark="Search downloaded games" Width="280" HorizontalAlignment="Left" />
        <Button Grid.Column="1" Classes="danger" Content="{Binding DeleteSelectedText}" IsVisible="{Binding HasSelection}"
                Command="{Binding DeleteSelectedCommand}" />
      </Grid>
    </StackPanel>

    <Panel Margin="0,12,0,0">
      <TextBlock Text="No game files found in the games directory." Classes="muted" HorizontalAlignment="Center"
                 VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
      <!-- The ScrollViewer lives inside the ItemsControl template so the VirtualizingStackPanel only creates visible rows. -->
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.Template>
          <ControlTemplate>
            <ScrollViewer>
              <ItemsPresenter Margin="0,0,0,24" />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:LocalGameViewModel">
            <Border Classes="card row" Classes.child="{Binding IsChild}" Padding="12">
              <Grid ColumnDefinitions="Auto,64,*,Auto,Auto">
                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Select for deletion" />
                <Panel Grid.Column="1" Width="56" Height="56" Background="{DynamicResource PlaceholderBrush}">
                  <PathIcon Data="{StaticResource IconGamepad}" Width="24" Height="24" Opacity="0.35" />
                  <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                </Panel>
                <StackPanel Grid.Column="2" Margin="12,0" Spacing="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Classes="badge" IsVisible="{Binding IsPinned}" Background="{DynamicResource AccentBrush}">
                      <TextBlock Text="Pinned" FontSize="11" Foreground="White" />
                    </Border>
                    <Border Classes="badge" IsVisible="{Binding IsUnverified}" Background="{DynamicResource WarningBrush}"
                            ToolTip.Tip="The file size changed since it was downloaded">
                      <TextBlock Text="Unverified" FontSize="11" Foreground="Black" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding ParentText}" Classes="small" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsChild}" />
                  <TextBlock Text="{Binding Details}" Classes="muted small" />
                  <!-- Not PathSegmentEllipsis: Avalonia throws while rendering it for some widths, which stops the window repainting. -->
                  <TextBlock Text="{Binding PathText}" Classes="muted small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathText}" />
                  <TextBlock Classes="muted small">
                    <Run Text="Downloaded: " /><Run Text="{Binding DownloadedText}" />
                    <Run Text="   Last accessed: " /><Run Text="{Binding LastAccessedText}" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button ToolTip.Tip="{Binding PinButtonText}" Command="{ReflectionBinding $parent[UserControl].DataContext.TogglePinCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconPin}" Width="14" Height="14" />
                      <TextBlock Text="{Binding PinButtonText}" />
                    </StackPanel>
                  </Button>
                  <Button ToolTip.Tip="Show in file manager" Command="{ReflectionBinding $parent[UserControl].DataContext.OpenFolderCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
                      <TextBlock Text="Open Folder" />
                    </StackPanel>
                  </Button>
                  <Button Classes="danger" ToolTip.Tip="Delete this game file" Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" Foreground="White" />
                      <TextBlock Text="Delete" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>
  </DockPanel>
</UserControl>
